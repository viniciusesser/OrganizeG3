# =============================================================================
# ORGANIZEG3 — EXAMPLE ENVIRONMENT
# =============================================================================
#
# Copie este arquivo para ".env" durante o desenvolvimento local.
# Nunca salve segredos reais no ".env.example".
# Nunca envie o arquivo ".env" para o Git.
#

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

APP_NAME=OrganizeG3 Platform API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

API_PREFIX=/api/v1
DOCS_ENABLED=true

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
#
# Exemplo PostgreSQL:
# postgresql+psycopg://usuario:senha@host:5432/banco
#

DATABASE_URL=
TEST_DATABASE_URL=

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=organizeg3-documents

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

CORS_ALLOW_CREDENTIALS=true

CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]

CORS_ALLOWED_HEADERS=["Authorization","Content-Type","Idempotency-Key","X-Correlation-ID","X-Device-ID","X-Tenant-ID"]

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

LOG_LEVEL=DEBUG
LOG_JSON=false
LOG_INCLUDE_SOURCE=true

# -----------------------------------------------------------------------------
# STORAGE AND UPLOADS
# -----------------------------------------------------------------------------

MAXIMUM_UPLOAD_SIZE_MB=25

ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".webp",".docx",".xlsx",".csv",".txt",".md"]

BLOCKED_UPLOAD_EXTENSIONS=[".skp",".dwg",".dxf",".rvt",".exe",".msi",".bat",".cmd",".ps1"]

# -----------------------------------------------------------------------------
# FEATURES
# -----------------------------------------------------------------------------

FEATURE_AI_ENABLED=false
FEATURE_REALTIME_ENABLED=true
FEATURE_OFFLINE_SYNC_ENABLED=true
FEATURE_PUSH_NOTIFICATIONS_ENABLED=false